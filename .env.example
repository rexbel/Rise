# Copy to .env.local (gitignored). Nothing here is required to run the seeded demo.

# Public HTTPS URL from scripts/tunnel.sh (used in SMS links)
PUBLIC_BASE_URL=https://example.trycloudflare.com
CLINIC_NAME="Riverside Ortho"

# ElevenLabs (pre-render voice lines: npm run voice)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Twilio (invite + callback SMS; trial accounts only send to verified numbers)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
DEMO_PATIENT_PHONE=

# NVIDIA Cosmos (endpoint details from organizers)
COSMOS_BASE_URL=
COSMOS_API_KEY=

# Weights & Biases (LLM inference + Weave tracing)
WANDB_API_KEY=
WANDB_INFERENCE_BASE_URL=
WANDB_MODEL=
WANDB_PROJECT=rise

# VAST (clip ingest + semantic search; details from organizers)
VAST_BASE_URL=
VAST_API_KEY=

# FHIR hand-off (should-have). Leave empty to use the built-in sandbox sink.
FHIR_BASE_URL=
# Optional: Synthetic Hospital simulator (docker compose up in that repo) for read-only patient context
EPIC_SIM_BASE_URL=http://localhost:8000
